// Given two binary strings a and b, return their sum as a binary string.

// Example 1:

// Input: a = "11", b = "1"
// Output: "100"
// Example 2:

// Input: a = "1010", b = "1011"
// Output: "10101"
class Solution {
    private String carry = "0";
    public String add(String a, String b){
        switch(a+","+b+","+carry){
            case "1,1,0":
            case "1,0,1":
            case "0,1,1":
                carry = "1";
                return "0";
            case "1,0,0":
            case "0,1,0":
            case "0,0,1":
                carry = "0";
                return "1";
            case "1,1,1":
                carry = "1";
                return "1";
        }
        return "0";
    }
    public String addBinary(String a, String b) {
        String ans = "";
        int pA = a.length()-1; int pB = b.length()-1;
        while(pA >= 0 && pB >= 0){
            ans = add(String.valueOf(a.charAt(pA)),String.valueOf(b.charAt(pB))) + ans;
            pA--; pB--;
        }
        int len = Math.min(a.length(), b.length());
        if(a.length() > b.length()){
            for (int i = a.length()-len-1; i >= 0; i--){
                ans = add(String.valueOf(a.charAt(i)),"0") + ans;
            }
        }else{
            for (int i = b.length()-len-1; i >= 0; i--){
                ans = add("0",String.valueOf(b.charAt(i))) + ans;
            }
        }
        if (!carry.equals("0"))
            ans = carry + ans;
        }
        return ans;
    }
}
