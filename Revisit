3650. Minimum Cost Path with Edge Reversals
class Solution {
    public int minCost(int n, int[][] edges) {
        int start = 0; int end = n-1;
        int prev = 0, curr = 0; int cost = 0; 
        ArrayList<Integer> costs = new ArrayList<>();
        for(int i=0; i<n; i++){
            if(edges[i][0] == curr){
                prev = edges[i][0];
                curr = edges[i][1];
                cost += edges[i][2];
            }else if(edges[i][1] == end){
                costs.add(cost);
                cost = 0;
            }else if(edges[i][1] == curr){
                prev = edges[i][1];
                curr = edges[i][0];
                cost += 2*edges[i][2];
            }
        }
        Collections.sort(costs);
        return costs.size() > 0 ? costs.get(0) : -1;
    }
}

